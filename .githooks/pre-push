#!/usr/bin/env bash
set -euo pipefail

should_check=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    should_check=1
  fi
done

if [[ "$should_check" != "1" ]]; then
  echo "[pre-push] Skipping deploy check: push target is not main."
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
exec "$REPO_ROOT/scripts/commit-deploy-check.sh"
