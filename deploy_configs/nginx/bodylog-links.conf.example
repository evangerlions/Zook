# Include INSIDE the existing HTTPS server for bodylog.app.
# Verify its TLS certificate/server_name first. This is an example, not a live config.
# dev uses 3101; online uses 3100. Keep the same environment as the intended release.
location = /.well-known/apple-app-site-association {
    proxy_pass http://127.0.0.1:3101;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    access_log off;
}
location ~ "^/(i|invite|b|g)/[A-Za-z0-9_-]{1,512}$" {
    proxy_pass http://127.0.0.1:3101;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    access_log off; # Invitation tokens must not enter access logs.
}
location = /invite-code {
    proxy_pass http://127.0.0.1:3101;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    access_log off;
}
