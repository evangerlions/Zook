DOCKER_IMAGE_NAME=zook
DEPLOY_SLOT=dev
COMPOSE_PROJECT_NAME=zook-dev
DEPLOY_HOST_BIND_IP=127.0.0.1
DEPLOY_HOST_PORT=3101
DEPLOY_CONTAINER_PORT=3100
ADMIN_HOST_PORT=3111
ADMIN_CONTAINER_PORT=3111
HEALTH_PATH=api/health
ADMIN_HEALTH_PATH=_admin/health
DATABASE_URL=postgresql://replace-me:replace-me@host.docker.internal:5432/zook_dev?schema=public
DIRECT_URL=postgresql://replace-me:replace-me@host.docker.internal:5432/zook_dev?schema=public
REDIS_URL=redis://:replace-me@host.docker.internal:6380/0
ADMIN_DEFAULT_APP_ID=app_a
ADMIN_BRAND_NAME=Zook Control Room
ADMIN_BASIC_AUTH_USERNAME=admin
ADMIN_BASIC_AUTH_PASSWORD=change-me-dev
PORT=3100
DEPLOY_KEEP_RELEASES=5
DEPLOY_BUILDER_PRUNE_UNTIL=168h
ZOOK_APP_RUN_DATA_HOST_PATH=/var/lib/zook/appRunData

# Add your dev environment variables below.
# AUTH_ACCESS_TOKEN_SECRET=replace-me
# REFRESH_TOKEN_SECRET=replace-me
FROGSLEEP_ENABLED=true
# Buddy growth rollout — all gates open on dev for iOS client end-to-end regression.
# Keep these aligned with what the iOS client calls under /api/v1/frogsleep/buddy/*.
# If a gate is flipped off, the matching routes fall through to 404 and the client
# surfaces an error state instead of real data.
FROGSLEEP_BUDDY_INBOX_ENABLED=true
FROGSLEEP_BUDDY_EXPLICIT_CONSENT_ENABLED=true
FROGSLEEP_BUDDY_GROWTH_HUB_ENABLED=true
FROGSLEEP_BUDDY_INTERACTIONS_ENABLED=true
FROGSLEEP_BUDDY_GOALS_REPORTS_ENABLED=true
# Push delivery. Safe to enable without APNs keys — worker will skip delivery
# gracefully when APNS_PRIVATE_KEY_PATH is not configured.
FROGSLEEP_BUDDY_PUSH_ENABLED=true
FROGSLEEP_BUDDY_EMAIL_ENABLED=true
# Focus buddy stranger-matching (search/dismiss/report). Off by default for v1
# invite-only launch. Set to true only after client-side matching UI ships.
FROGSLEEP_BUDDY_FOCUS_MATCHING_ENABLED=false
FROGSLEEP_BUDDY_HANDOFF_BASE_URL=https://app-dev.youwoai.net/frogsleep/buddy-invitation
# FrogSleep push / APNs. Use sandbox only for development devices.
# APNS_KEY_ID=replace-me
# APNS_TEAM_ID=replace-me
# APNS_BUNDLE_ID=com.hulusleep.app
# APNS_PRIVATE_KEY_PATH=/app/appRunData/apns/AuthKey_replace-me.p8
# APNS_SANDBOX=true
# Make sure PostgreSQL and Redis listen on an address reachable from Docker,
# not only 127.0.0.1, when using host.docker.internal.
BAILIAN_API_KEY=mock-bailian-api-key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GEO_RESOLVER_URL=https://geo.example.com/lookup
# GEO_RESOLVER_TOKEN=replace-me
GEO_RESOLVER_TIMEOUT_MS=1500
