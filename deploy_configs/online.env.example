DOCKER_IMAGE_NAME=zook
DEPLOY_SLOT=online
COMPOSE_PROJECT_NAME=zook-online
DEPLOY_HOST_BIND_IP=127.0.0.1
DEPLOY_HOST_PORT=3100
DEPLOY_CONTAINER_PORT=3100
ADMIN_HOST_PORT=3110
ADMIN_CONTAINER_PORT=3110
HEALTH_PATH=api/health
ADMIN_HEALTH_PATH=_admin/health
DATABASE_URL=postgresql://replace-me:replace-me@host.docker.internal:5432/zook_online?schema=public
DIRECT_URL=postgresql://replace-me:replace-me@host.docker.internal:5432/zook_online?schema=public
REDIS_URL=redis://:replace-me@host.docker.internal:6379/0
ADMIN_DEFAULT_APP_ID=app_a
ADMIN_BRAND_NAME=Zook Control Room
ADMIN_BASIC_AUTH_USERNAME=admin
ADMIN_BASIC_AUTH_PASSWORD=change-me-online
PORT=3100
DEPLOY_KEEP_RELEASES=5
DEPLOY_BUILDER_PRUNE_UNTIL=168h

# Add your online environment variables below.
# AUTH_ACCESS_TOKEN_SECRET=replace-me
# REFRESH_TOKEN_SECRET=replace-me
FROGSLEEP_ENABLED=true
FROGSLEEP_BUDDY_INBOX_ENABLED=true
FROGSLEEP_BUDDY_EXPLICIT_CONSENT_ENABLED=true
FROGSLEEP_BUDDY_GROWTH_HUB_ENABLED=true
FROGSLEEP_BUDDY_INTERACTIONS_ENABLED=true
FROGSLEEP_BUDDY_GOALS_REPORTS_ENABLED=true
FROGSLEEP_BUDDY_PUSH_ENABLED=true
FROGSLEEP_BUDDY_EMAIL_ENABLED=true
# Stranger-matching for focus buddy. Off for v1 invite-only launch.
FROGSLEEP_BUDDY_FOCUS_MATCHING_ENABLED=false
# Group (multi-person) buddy support. Off for v1 launch (1-on-1 only).
FROGSLEEP_BUDDY_GROUP_ENABLED=false
FROGSLEEP_BUDDY_HANDOFF_BASE_URL=https://app.youwoai.net/frogsleep/buddy-invitation
# FrogSleep push / APNs. Keep private key files on the server, not in git.
# APNS_KEY_ID=replace-me
# APNS_TEAM_ID=replace-me
# APNS_BUNDLE_ID=com.hulusleep.app
# LIGHTTICK_APNS_BUNDLE_ID=com.lighttick.app
# APNS_PRIVATE_KEY_PATH=/app/appRunData/apns/AuthKey_replace-me.p8
# APNS_SANDBOX=false
# LIGHTTICK_FCM_PROJECT_ID=replace-me
# LIGHTTICK_FCM_SERVICE_ACCOUNT_PATH=/app/appRunData/fcm/lighttick-service-account.json
# Make sure PostgreSQL and Redis listen on an address reachable from Docker,
# not only 127.0.0.1, when using host.docker.internal.
BAILIAN_API_KEY=mock-bailian-api-key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENROUTER_API_KEY=replace-me
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEO_RESOLVER_URL=https://geo.example.com/lookup
# GEO_RESOLVER_TOKEN=replace-me
GEO_RESOLVER_TIMEOUT_MS=1500

# OrangeWrite transparent telemetry destinations. Keep secrets in deployed env only.
# GA4_ORANGEWRITE_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_ORANGEWRITE_API_SECRET=replace-me
# SENTRY_ORANGEWRITE_PROJECT_ID=replace-me
# SENTRY_ORANGEWRITE_PUBLIC_KEY=replace-me
# SENTRY_ORANGEWRITE_INGEST_ORIGIN=https://o0.ingest.sentry.io
# Comma-separated IP addresses of reverse proxies allowed to supply X-Forwarded-For.
# Loopback addresses are always trusted for same-host Caddy/Nginx deployments.
# ZOOK_TRUSTED_PROXY_IPS=10.0.0.2
