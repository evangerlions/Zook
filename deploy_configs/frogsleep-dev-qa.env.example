# Copy outside Git to ~/.zook-private/frogsleep-dev.env; chmod 600.
# Dedicated dev identities only. Blank values are not working accounts.
# Register A/B/C normally with mailboxes you control; D must be disposable.
# Never put credentials in chat or use personal/online accounts here.
SMOKE_A_EMAIL=
SMOKE_A_PASSWORD=
SMOKE_B_EMAIL=
SMOKE_B_PASSWORD=
SMOKE_C_EMAIL=
SMOKE_C_PASSWORD=
SMOKE_DELETE_EMAIL=
SMOKE_DELETE_PASSWORD=
