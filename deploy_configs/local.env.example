# Copy to deploy_configs/local.env for your own machine.

DATABASE_URL=postgresql://replace-me:replace-me@127.0.0.1:5432/zook_online?schema=public
DIRECT_URL=postgresql://replace-me:replace-me@127.0.0.1:5432/zook_online?schema=public
REDIS_URL=redis://:replace-me@127.0.0.1:6379/0
AUTH_ACCESS_TOKEN_SECRET=replace-me-with-a-random-secret
FROGSLEEP_ENABLED=true
FROGSLEEP_BUDDY_EMAIL_ENABLED=false
# Stranger-matching for focus buddy. Off for v1 invite-only launch.
FROGSLEEP_BUDDY_FOCUS_MATCHING_ENABLED=false
# Group (multi-person) buddy support. Off for v1 launch.
FROGSLEEP_BUDDY_GROUP_ENABLED=false
FROGSLEEP_BUDDY_HANDOFF_BASE_URL=http://127.0.0.1:3100/frogsleep/buddy-invitation

ADMIN_BASIC_AUTH_USERNAME=admin
ADMIN_BASIC_AUTH_PASSWORD=Admin123456!
ADMIN_DEFAULT_APP_ID=app_a
ADMIN_BRAND_NAME=Zook Control Room

API_PORT=3100
ADMIN_PORT=3110
