# Copy to deploy_configs/local.env for your own machine.

DATABASE_URL=postgresql://replace-me:replace-me@127.0.0.1:5432/zook_online?schema=public
DIRECT_URL=postgresql://replace-me:replace-me@127.0.0.1:5432/zook_online?schema=public
REDIS_URL=redis://:replace-me@127.0.0.1:6379/0
AUTH_ACCESS_TOKEN_SECRET=replace-me-with-a-random-secret
FROGSLEEP_ENABLED=true
FROGSLEEP_BUDDY_EMAIL_ENABLED=false
# Stranger-matching for focus buddy. Off for v1 invite-only launch.
FROGSLEEP_BUDDY_FOCUS_MATCHING_ENABLED=false
# Group (multi-person) buddy support. Off for v1 launch.
FROGSLEEP_BUDDY_GROUP_ENABLED=false
FROGSLEEP_BUDDY_HANDOFF_BASE_URL=http://127.0.0.1:3100/frogsleep/buddy-invitation

ADMIN_BASIC_AUTH_USERNAME=admin
ADMIN_BASIC_AUTH_PASSWORD=Admin123456!
ADMIN_DEFAULT_APP_ID=app_a
ADMIN_BRAND_NAME=Zook Control Room

API_PORT=3100
ADMIN_PORT=3110

# RevenueCat REST V2: non-secret identifiers, project-scoped read-only secret.
REVENUECAT_AI_NOVEL_ALLOW_SANDBOX=true
# REVENUECAT_AI_NOVEL_PROJECT_ID=...
# REVENUECAT_AI_NOVEL_APP_ID=...
# REVENUECAT_AI_NOVEL_GOOGLE_APP_ID=... # RC Google app ID, not Android package name
# Alipay is explicitly gated. Mount private key files outside the image/Git.
ALIPAY_AI_NOVEL_ENABLED=false
ALIPAY_AI_NOVEL_PRICES_APPROVED=false
# ALIPAY_AI_NOVEL_PRICES_JSON={"plus_monthly":3800,"plus_quarterly":9800,"plus_yearly":29800,"pro_monthly":8800,"pro_quarterly":22800,"pro_yearly":59800}
ALIPAY_AI_NOVEL_ENVIRONMENT=sandbox
# ALIPAY_AI_NOVEL_APP_ID=replace-with-this-environment-app
# ALIPAY_AI_NOVEL_SELLER_ID= # Optional; omit for the application's signing merchant
# ALIPAY_AI_NOVEL_PRIVATE_KEY_PATH=/run/secrets/alipay-app-private-key.pem
# ALIPAY_AI_NOVEL_PUBLIC_KEY_PATH=/run/secrets/alipay-platform-public-key.pem
# ALIPAY_AI_NOVEL_NOTIFY_URL=https://api.example.com/api/v1/ai_novel/billing/webhooks/alipay
# ALIPAY_AI_NOVEL_RETURN_URL=https://app.example.com/#/membership
# REVENUECAT_AI_NOVEL_SECRET_API_KEY=...
# REVENUECAT_AI_NOVEL_WEBHOOK_AUTHORIZATION=...
