# EXAMPLE ONLY. Copy privately to grow-dev.env or grow-online.env (chmod 600).
# Replace all placeholders on the server. Never commit real values.
DATABASE_URL=postgresql://<grow-role>:<private-password>@<database-host>/<dedicated-grow-dev-db>
ACCOUNT_ENCRYPTION_KEY=<new-dev-Fernet-key>
APP_USERNAME=<synthetic-dev-owner>
APP_PASSWORD=<at-least-24-random-characters>
PLAN_CONTENT_BACKEND=github
GITHUB_CONTENT_REPO=<owner>/<isolated-test-repository>
GITHUB_CONTENT_BRANCH=main
GITHUB_CONTENT_TOKEN=<server-only-scoped-GitHub-credential>
GROW_PUBLIC_URL=https://app-dev.youwoai.net/grow
GROW_BASE_PATH=/grow
LIGHTTICK_BRIDGE_URL=https://app-dev.youwoai.net
GROW_ACTION_BRIDGE_SECRET=<same-private-dev-secret-as-Zook-dev>
GROW_ZOOK_WEB_AUTH_ENABLED=1
GROW_NATIVE_BASIC_PLANS_ENABLED=1
GROW_SCHEDULED_READING_ENABLED=0
CLOUD_DEPLOY=1
WEB_CONCURRENCY=1
FORWARDED_ALLOW_IPS=<controlled-proxy-peer-IP>
# Existing tenants must retain their existing key and DB; never overwrite with a new key.
