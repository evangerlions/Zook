{
  "name": "zook-backend-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-transform-types src/main.ts",
    "dev:stack": "bash ./scripts/dev-stack.sh",
    "generate:public-contracts": "python3 build_scripts/generate_public_contracts.py --out src/generated/openapi/public-contracts.generated.ts",
    "check:api-contracts": "python3 build_scripts/generate_public_contracts.py --check --out src/generated/openapi/public-contracts.generated.ts",
    "lint:api-contracts": "npm --prefix api-contracts run openapi:lint",
    "generate:public-i18n": "python3 build_scripts/generate_public_i18n.py --out src/generated/i18n/public-api-messages.generated.ts",
    "admin": "node --experimental-transform-types apps/admin-web/server.ts",
    "admin:build": "npm --prefix apps/admin-web run build",
    "admin:dev": "npm --prefix apps/admin-web run dev",
    "admin:install": "npm --prefix apps/admin-web install --include=optional",
    "admin:typecheck": "npm --prefix apps/admin-web run typecheck",
    "check:line-count": "node scripts/check-source-line-count.mjs",
    "smoke:frogsleep-zook": "node scripts/frogsleep-zook-smoke.mjs",
    "smoke:frogsleep-buddy-invitation": "node scripts/frogsleep-buddy-invitation-smoke.mjs",
    "smoke:lighttick-dev": "node scripts/lighttick-dev-acceptance.mjs",
    "observe:frogsleep-buddy-rollout": "node --experimental-transform-types scripts/frogsleep-buddy-rollout-observation.ts",
    "worker": "node --experimental-transform-types src/worker.ts",
    "test": "node --experimental-transform-types --test test/unit/*.test.ts",
    "test:postgres:buddy": "node --experimental-transform-types --test test/integration/frogsleep-buddy-postgres-concurrency.test.ts",
    "test:postgres:buddy-migration": "node --experimental-transform-types --test test/integration/frogsleep-buddy-postgres-migration-upgrade.test.ts",
    "test:postgres:lighttick": "node --experimental-transform-types --test test/integration/lighttick-postgres.test.ts",
    "test:lighttick-ai-evals": "node --experimental-transform-types --test test/unit/lighttick-ai-platform.test.ts"
  },
  "devDependencies": {
    "@types/node": "^25.3.5"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "pg": "^8.20.0",
    "redis": "^5.11.0"
  }
}
